{
  "target_equipment": "GT-2420A",
  "pi_web_api": {
    "base_url": "https://kul-pivision.pttep.com/piwebapi",
    "auth_type": "basic",
    "user": "pi-ai",
    "password": "change_in_production",
    "verify_ssl": false,
    "timeout_seconds": 30,
    "mock_mode": false,
    "query_mode": "interpolated",
    "sample_interval": "1h",
    "duration_months": 6,
    "slice_days": 30,
    "batch_size": 25,
    "batch_throttle_calls": 5,
    "batch_throttle_delay_seconds": 5.0
  },
  "database": {
    "engine": "mssql",
    "host": "localhost",
    "port": 1433,
    "database": "PTTEP_AI",
    "user": "pi-ai",
    "password": "change_in_production",
    "driver": "SQL Server",
    "table_name": "operating_limits",
    "use_sqlite_fallback": true,
    "sqlite_path": "data/operating_limits.db",
    "deduplication_tolerance": 0.0001
  },
  "operating_limits": {
    "method": "percentile",
    "normal_stat": "median",
    "percentiles": {
      "ll": 1.0,
      "l": 5.0,
      "h": 95.0,
      "hh": 99.0
    },
    "sigma_multipliers": {
      "ll": 3.0,
      "l": 2.0,
      "h": 2.0,
      "hh": 3.0
    }
  },
  "storage": {
    "parquet_file": "data/historical_data_hourly.parquet",
    "limits_csv_file": "data/operating_limits.csv",
    "completed_slices_file": "data/completed_slices.json"
  }
}
